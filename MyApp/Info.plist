<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>EcoPlog takes the Before and After photos of a cleanup.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>EcoPlog reads your heart rate, steps and energy to show your cleanup stats.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>EcoPlog saves your cleanups as workouts in Apple Health.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>EcoPlog keeps recording your route when the screen is locked during a cleanup.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>EcoPlog records your route while you clean up.</string>
	<key>NSMotionUsageDescription</key>
	<string>EcoPlog counts your steps during a cleanup.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>EcoPlog saves your cleanup reel to your photo library.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Inter.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
